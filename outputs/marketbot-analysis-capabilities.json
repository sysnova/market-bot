{
  "catalog_version": "1.0.0",
  "generated_for_marketbot_definition": "4.0.0",
  "purpose": "Shareable catalog of analytical information emitted or persisted by MarketBot engines.",
  "serialization": {
    "format": "JSON",
    "timestamps": "ISO-8601 UTC",
    "financial_numbers": "decimal serialized as string",
    "identifiers": "UUIDv7 unless otherwise stated",
    "optional_fields": "null or absent when history or evidence is insufficient"
  },
  "persistence": {
    "jetstream": {
      "stream": "MARKETBOT",
      "retention_days": 15,
      "contains": "Published analytical events and assessments"
    },
    "postgresql": {
      "contains": [
        "OHLCV market bars",
        "market rotation detail",
        "Peter Lynch current evaluation",
        "entry watcher and entry opportunity lifecycle",
        "selected portfolio and PatreonCaps state"
      ],
      "does_not_contain": "A permanent row for every AnalysisResult produced by Long, Swing or Intraday"
    },
    "alert_ndjson": {
      "contains": "Full component analyses only when they participated in an emitted LocalAlert"
    }
  },
  "event_envelope": {
    "event_id": "uuidv7",
    "event_type": "string",
    "schema_version": "semver",
    "occurred_at": "datetime UTC",
    "source": "engine identifier",
    "trace_id": "uuid|null",
    "correlation_id": "uuid|null",
    "causation_id": "uuid|null",
    "market_session": "PRE_MARKET|REGULAR|AFTER_HOURS|CLOSED|CONTINUOUS|null",
    "subject": "symbol or global scope",
    "payload": "engine-specific object",
    "attributes": [
      {
        "name": "string",
        "value": "any JSON value"
      }
    ]
  },
