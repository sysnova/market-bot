//@version=6
// MarketBot TradingView Viewer v3.3
// Lee cada campo contra el esquema v3 interno; la cabecera pegada es opcional y se ignora.
indicator("MarketBot · Engines Alpaca v3.3", overlay=true)
plot(na, "MarketBot compiler sentinel", display=display.none, editable=false)

grupoImport = "MarketBot · Datos"
const string SCHEMA_CSV = "ticker,schemaVersion,modoNiveles,marcoCalculo,zonaLowManual,zonaHighManual,soporteManual,invalidationManual,resistenciaManual,liquidezManual,avwapPivotManual,avwapBreakoutManual,extendedTarget,asOf,fuenteDatos,swingSma20,swingSma50,swingTarget,pivotLowAnchorAt,breakoutAnchorAt,swingVerdict,swingDirection,swingScore,swingEntryGatePassed,stImpulseLow,stImpulseHigh,stImpulseLowAt,stImpulseHighAt,stFib618,stFib50,stFib1618,stZoneLow,stZoneHigh,stSupport20,stResistance20,stInvalidation,stPrimaryTarget,stExtendedTarget,stGeometryStatus,stMaturity,stEligible,stReasons,geriZoneLow,geriZoneHigh,geriInvalidation,geriActiveLevelKind,geriActiveLevelPrice,geriActiveLevelSequence,geriMaturity,geriTradeSide,geriBounceConfirmed,geriFastConfirmation,geriFourHourConfirmation,geriReasons,geriN1Kind,geriN1Price,geriN2Kind,geriN2Price,geriN3Kind,geriN3Price,swingInvalidationSources,supportState,supportConfirmationType,supportZoneLow,supportZoneCenter,supportZoneHigh,supportInvalidation,supportScore,supportReactionScore,supportReversalScore,supportActionabilityScore,supportZonePosition,supportSources,supportImpulseOrigin,supportImpulseOriginAt,supportImpulsePeak,supportImpulseAdvancePercent,supportFib50,supportFib618,supportFib786,supportReasons"
configCsv = input.text_area(
     SCHEMA_CSV,
     "CSV MarketBot v3",
     group=grupoImport,
     tooltip="Pegá el CSV completo o solamente sus filas. El visor reconoce la cabecera automáticamente y selecciona el ticker abierto."
)
grupoCapas = "MarketBot · Capas"
mostrarSwing = input.bool(true, "Swing Diario", group=grupoCapas)
mostrarFibo = input.bool(true, "SwingTrade", group=grupoCapas)
mostrarFiboContexto = input.bool(false, "SwingTrade · impulso y soporte", group=grupoCapas)
mostrarGeri = input.bool(true, "GERI 4H", group=grupoCapas)
mostrarSupportValidation = input.bool(true, "Support Validation al invalidarse Swing", group=grupoCapas)
mostrarAvwap = input.bool(true, "AVWAP", group=grupoCapas)
mostrarMedias = input.bool(false, "SMA20 / SMA50", group=grupoCapas)
mostrarDashboard = input.bool(true, "Dashboard", group=grupoCapas)

f_clean(string value) =>
    string clean = str.replace_all(str.replace_all(value, "\r", ""), " ", "")
    clean := str.replace_all(clean, "\"", "")
    str.replace_all(clean, "﻿", "")

f_normalize_ticker(string value) =>
    string clean = str.upper(f_clean(value))
    array<string> exchangeParts = str.split(clean, ":")
    string withoutExchange = array.size(exchangeParts) > 1 ? array.get(exchangeParts, array.size(exchangeParts) - 1) : clean
    array<string> suffixParts = str.split(withoutExchange, ".")
    string suffix = array.size(suffixParts) > 1 ? array.get(suffixParts, array.size(suffixParts) - 1) : ""
    suffix == "US" ? array.get(suffixParts, 0) : withoutExchange

f_split_line(string line) =>
    string cleanLine = str.replace_all(line, "\r", "")
    string separator = ";"
    if str.contains(cleanLine, "\t")
        separator := "\t"
    else if str.contains(cleanLine, ",")
        separator := ","
    str.split(cleanLine, separator)

f_row(string csv, string target) =>
    array<string> selected = array.new_string()
    array<string> rows = str.split(csv, "\n")
    if array.size(rows) > 0
        for i = 0 to array.size(rows) - 1
            array<string> cols = f_split_line(array.get(rows, i))
            if array.size(cols) > 0
                string rowTicker = f_normalize_ticker(array.get(cols, 0))
                bool isHeader = str.lower(f_clean(array.get(cols, 0))) == "ticker"
                if not isHeader and array.size(selected) == 0 and rowTicker == f_normalize_ticker(target)
                    selected := array.copy(cols)
    selected

f_text_col(array<string> values, array<string> header, string name, string fallback) =>
    int index = array.indexof(header, name)
    string value = index >= 0 and array.size(values) > index ? f_clean(array.get(values, index)) : ""
    str.length(value) > 0 ? value : fallback

f_num_col(array<string> values, array<string> header, string name) =>
    float value = str.tonumber(f_text_col(values, header, name, "0"))
    na(value) ? 0.0 : value

f_has(array<string> header, string name) => array.indexof(header, name) >= 0
f_valid_zone(float low, float high) => low > 0 and high >= low
f_plot(float value, bool visible) => visible and value > 0 ? value : na
f_range(float low, float high) => str.tostring(low, "0.0000") + " - " + str.tostring(high, "0.0000")

var array<string> csvHeader = str.split(SCHEMA_CSV, ",")
var array<string> cfg = array.new_string()
string targetTicker = syminfo.ticker
if barstate.isfirst
    cfg := f_row(configCsv, targetTicker)

bool rowFound = array.size(cfg) > 0
bool rowComplete = rowFound and array.size(cfg) >= array.size(csvHeader)
bool swingSchema = f_has(csvHeader, "zonaLowManual") and f_has(csvHeader, "invalidationManual")
bool swingTradeSchema = f_has(csvHeader, "stZoneLow") and f_has(csvHeader, "stInvalidation")
bool geriSchema = f_has(csvHeader, "geriActiveLevelKind") and f_has(csvHeader, "geriActiveLevelPrice")
bool schemaValid = swingSchema and swingTradeSchema and geriSchema
bool dataReady = rowFound and rowComplete and schemaValid

string schemaVersion = f_text_col(cfg, csvHeader, "schemaVersion", "LEGACY")
string rowTicker = f_text_col(cfg, csvHeader, "ticker", "SIN_DATO")
string asOf = f_text_col(cfg, csvHeader, "asOf", "SIN_DATO")
string dataSource = f_text_col(cfg, csvHeader, "fuenteDatos", "SIN_DATO")

float swingZoneLow = f_num_col(cfg, csvHeader, "zonaLowManual")
float swingZoneHigh = f_num_col(cfg, csvHeader, "zonaHighManual")
float swingSupport = f_num_col(cfg, csvHeader, "soporteManual")
float swingInvalidation = f_num_col(cfg, csvHeader, "invalidationManual")
float swingResistance = f_num_col(cfg, csvHeader, "resistenciaManual")
float swingLiquidity = f_num_col(cfg, csvHeader, "liquidezManual")
float pivotAvwap = f_num_col(cfg, csvHeader, "avwapPivotManual")
float breakoutAvwap = f_num_col(cfg, csvHeader, "avwapBreakoutManual")
float swingSma20 = f_num_col(cfg, csvHeader, "swingSma20")
float swingSma50 = f_num_col(cfg, csvHeader, "swingSma50")
float swingTarget = f_num_col(cfg, csvHeader, "swingTarget")
string swingVerdict = f_text_col(cfg, csvHeader, "swingVerdict", "SIN_DATO")
string swingDirection = f_text_col(cfg, csvHeader, "swingDirection", "SIN_DATO")
string swingScore = f_text_col(cfg, csvHeader, "swingScore", "SIN_DATO")
string swingGate = f_text_col(cfg, csvHeader, "swingEntryGatePassed", "SIN_DATO")

float stImpulseLow = f_num_col(cfg, csvHeader, "stImpulseLow")
float stImpulseHigh = f_num_col(cfg, csvHeader, "stImpulseHigh")
float stZoneLow = f_num_col(cfg, csvHeader, "stZoneLow")
float stZoneHigh = f_num_col(cfg, csvHeader, "stZoneHigh")
float stSupport20 = f_num_col(cfg, csvHeader, "stSupport20")
float stInvalidation = f_num_col(cfg, csvHeader, "stInvalidation")
float stPrimaryTarget = f_num_col(cfg, csvHeader, "stPrimaryTarget")
float stExtendedTarget = f_num_col(cfg, csvHeader, "stExtendedTarget")
string stGeometryStatus = f_text_col(cfg, csvHeader, "stGeometryStatus", f_valid_zone(stZoneLow, stZoneHigh) ? "LEGACY_GEOMETRY" : "SIN_DATO")
string stMaturity = f_text_col(cfg, csvHeader, "stMaturity", "SIN_DATO")
string stEligible = f_text_col(cfg, csvHeader, "stEligible", "SIN_DATO")

float geriZoneLow = f_num_col(cfg, csvHeader, "geriZoneLow")
float geriZoneHigh = f_num_col(cfg, csvHeader, "geriZoneHigh")
float geriInvalidation = f_num_col(cfg, csvHeader, "geriInvalidation")
string geriLevelKind = f_text_col(cfg, csvHeader, "geriActiveLevelKind", "SIN_DATO")
float geriLevelPrice = f_num_col(cfg, csvHeader, "geriActiveLevelPrice")
string geriLevelSequence = f_text_col(cfg, csvHeader, "geriActiveLevelSequence", "-")
string geriMaturity = f_text_col(cfg, csvHeader, "geriMaturity", "SIN_DATO")
string geriTradeSide = f_text_col(cfg, csvHeader, "geriTradeSide", "SIN_DATO")
string geriBounce = f_text_col(cfg, csvHeader, "geriBounceConfirmed", "SIN_DATO")
string geriFast = f_text_col(cfg, csvHeader, "geriFastConfirmation", "SIN_DATO")
string geriFourHour = f_text_col(cfg, csvHeader, "geriFourHourConfirmation", "SIN_DATO")
string geriN1Kind = f_text_col(cfg, csvHeader, "geriN1Kind", "SIN_DATO")
float geriN1Price = f_num_col(cfg, csvHeader, "geriN1Price")
string geriN2Kind = f_text_col(cfg, csvHeader, "geriN2Kind", "SIN_DATO")
float geriN2Price = f_num_col(cfg, csvHeader, "geriN2Price")
string geriN3Kind = f_text_col(cfg, csvHeader, "geriN3Kind", "SIN_DATO")
float geriN3Price = f_num_col(cfg, csvHeader, "geriN3Price")

string swingInvalidationSources = f_text_col(cfg, csvHeader, "swingInvalidationSources", "SIN_DATO")
string supportState = f_text_col(cfg, csvHeader, "supportState", "SIN_DATO")
string supportConfirmationType = f_text_col(cfg, csvHeader, "supportConfirmationType", "SIN_DATO")
float supportZoneLow = f_num_col(cfg, csvHeader, "supportZoneLow")
float supportZoneCenter = f_num_col(cfg, csvHeader, "supportZoneCenter")
float supportZoneHigh = f_num_col(cfg, csvHeader, "supportZoneHigh")
float supportInvalidation = f_num_col(cfg, csvHeader, "supportInvalidation")
string supportScore = f_text_col(cfg, csvHeader, "supportScore", "SIN_DATO")
string supportReactionScore = f_text_col(cfg, csvHeader, "supportReactionScore", "SIN_DATO")
string supportReversalScore = f_text_col(cfg, csvHeader, "supportReversalScore", "SIN_DATO")
string supportActionabilityScore = f_text_col(cfg, csvHeader, "supportActionabilityScore", "SIN_DATO")
string supportZonePosition = f_text_col(cfg, csvHeader, "supportZonePosition", "SIN_DATO")
float supportImpulseOrigin = f_num_col(cfg, csvHeader, "supportImpulseOrigin")
float supportImpulsePeak = f_num_col(cfg, csvHeader, "supportImpulsePeak")
string supportImpulseAdvance = f_text_col(cfg, csvHeader, "supportImpulseAdvancePercent", "SIN_DATO")
float supportFib50 = f_num_col(cfg, csvHeader, "supportFib50")
float supportFib618 = f_num_col(cfg, csvHeader, "supportFib618")
float supportFib786 = f_num_col(cfg, csvHeader, "supportFib786")

bool swingLoaded = dataReady
bool swingTradeLoaded = dataReady and stGeometryStatus == "ENGINE_ASSESSMENT" and f_valid_zone(stZoneLow, stZoneHigh)
bool geriLoaded = dataReady
bool supportLoaded = dataReady and swingInvalidationSources != "SIN_DATO" and supportState != "SIN_DATO"

// Swing Diario: zona verde y niveles propios del engine.
pSwingHigh = plot(f_plot(swingZoneHigh, swingLoaded and mostrarSwing), "Swing Diario · zona alta", color=color.lime, style=plot.style_linebr)
pSwingLow = plot(f_plot(swingZoneLow, swingLoaded and mostrarSwing), "Swing Diario · zona baja", color=color.lime, style=plot.style_linebr)
fill(pSwingHigh, pSwingLow, color=swingLoaded and mostrarSwing and f_valid_zone(swingZoneLow, swingZoneHigh) ? color.new(color.lime, 84) : na, title="Swing Diario · zona")
plot(f_plot(swingSupport, swingLoaded and mostrarSwing), "Swing Diario · soporte", color=color.aqua, linewidth=2, style=plot.style_linebr)
plot(f_plot(swingInvalidation, swingLoaded and mostrarSwing), "Swing Diario · invalidación", color=color.red, linewidth=2, style=plot.style_linebr)
plot(f_plot(swingResistance, swingLoaded and mostrarSwing), "Swing Diario · resistencia", color=color.purple, linewidth=2, style=plot.style_linebr)
plot(f_plot(swingLiquidity, swingLoaded and mostrarSwing), "Swing Diario · liquidez", color=color.fuchsia, style=plot.style_linebr)
plot(f_plot(swingTarget, swingLoaded and mostrarSwing), "Swing Diario · target 2R", color=color.green, linewidth=2, style=plot.style_linebr)

// SwingTrade: una sola representación por nivel contractual; no duplica resistance20/primaryTarget.
pStHigh = plot(f_plot(stZoneHigh, swingTradeLoaded and mostrarFibo), "SwingTrade · F50", color=color.rgb(70, 130, 255), linewidth=2, style=plot.style_linebr)
pStLow = plot(f_plot(stZoneLow, swingTradeLoaded and mostrarFibo), "SwingTrade · F61.8", color=color.rgb(70, 130, 255), linewidth=2, style=plot.style_linebr)
fill(pStHigh, pStLow, color=swingTradeLoaded and mostrarFibo ? color.new(color.blue, 84) : na, title="SwingTrade · zona Fibonacci")
plot(f_plot(stInvalidation, swingTradeLoaded and mostrarFibo), "SwingTrade · invalidación", color=color.new(color.red, 25), linewidth=2, style=plot.style_linebr)
plot(f_plot(stPrimaryTarget, swingTradeLoaded and mostrarFibo), "SwingTrade · target primario", color=color.green, linewidth=2, style=plot.style_linebr)
plot(f_plot(stExtendedTarget, swingTradeLoaded and mostrarFibo), "SwingTrade · extensión 161.8", color=color.teal, linewidth=2, style=plot.style_linebr)
plot(f_plot(stImpulseLow, swingTradeLoaded and mostrarFiboContexto), "SwingTrade · origen impulso", color=color.gray, style=plot.style_linebr)
plot(f_plot(stImpulseHigh, swingTradeLoaded and mostrarFiboContexto), "SwingTrade · pico impulso", color=color.silver, style=plot.style_linebr)
plot(f_plot(stSupport20, swingTradeLoaded and mostrarFiboContexto), "SwingTrade · soporte 20D", color=color.new(color.aqua, 20), linewidth=2, style=plot.style_linebr)

// GERI 4H: zona sólo si el exportador entregó soporte LONG dibujable; niveles N siempre visibles.
pGeriHigh = plot(f_plot(geriZoneHigh, geriLoaded and mostrarGeri), "GERI 4H · zona alta", color=color.rgb(190, 100, 255), style=plot.style_linebr)
pGeriLow = plot(f_plot(geriZoneLow, geriLoaded and mostrarGeri), "GERI 4H · zona baja", color=color.rgb(190, 100, 255), style=plot.style_linebr)
fill(pGeriHigh, pGeriLow, color=geriLoaded and mostrarGeri and f_valid_zone(geriZoneLow, geriZoneHigh) ? color.new(color.purple, 86) : na, title="GERI 4H · zona")
plot(f_plot(geriInvalidation, geriLoaded and mostrarGeri), "GERI 4H · invalidación", color=color.new(color.red, 55), linewidth=2, style=plot.style_linebr)
plot(f_plot(geriN1Price, geriLoaded and mostrarGeri), "GERI 4H · N1", color=geriN1Kind == "SUPPORT" ? color.new(color.aqua, 55) : color.new(color.fuchsia, 55), linewidth=1, style=plot.style_linebr)
plot(f_plot(geriN2Price, geriLoaded and mostrarGeri), "GERI 4H · N2", color=geriN2Kind == "SUPPORT" ? color.new(color.aqua, 30) : color.new(color.fuchsia, 30), linewidth=2, style=plot.style_linebr)
plot(f_plot(geriN3Price, geriLoaded and mostrarGeri), "GERI 4H · N3", color=geriN3Kind == "SUPPORT" ? color.aqua : color.fuchsia, linewidth=3, style=plot.style_linebr)
plot(f_plot(geriLevelPrice, geriLoaded and mostrarGeri), "GERI 4H · nivel activo", color=geriLevelKind == "SUPPORT" ? color.aqua : color.fuchsia, linewidth=3, style=plot.style_linebr)

// Support Confirmation: aparece sólo cuando el CSV informa una invalidación Swing real.
pSupportHigh = plot(f_plot(supportZoneHigh, supportLoaded and mostrarSupportValidation), "Support Validation · zona alta", color=color.rgb(255, 170, 0), linewidth=2, style=plot.style_linebr)
pSupportLow = plot(f_plot(supportZoneLow, supportLoaded and mostrarSupportValidation), "Support Validation · zona baja", color=color.rgb(255, 170, 0), linewidth=2, style=plot.style_linebr)
fill(pSupportHigh, pSupportLow, color=supportLoaded and mostrarSupportValidation and f_valid_zone(supportZoneLow, supportZoneHigh) ? color.new(color.orange, 82) : na, title="Support Validation · zona")
plot(f_plot(supportZoneCenter, supportLoaded and mostrarSupportValidation), "Support Validation · centro", color=color.yellow, linewidth=2, style=plot.style_linebr)
plot(f_plot(supportInvalidation, supportLoaded and mostrarSupportValidation), "Support Validation · invalidación", color=color.rgb(180, 35, 35), linewidth=2, style=plot.style_linebr)
plot(f_plot(supportFib50, supportLoaded and mostrarSupportValidation), "Support Validation · impulso F50", color=color.rgb(255, 215, 0), linewidth=1, style=plot.style_linebr)
plot(f_plot(supportFib618, supportLoaded and mostrarSupportValidation), "Support Validation · impulso F61.8", color=color.rgb(255, 193, 7), linewidth=3, style=plot.style_linebr)
plot(f_plot(supportFib786, supportLoaded and mostrarSupportValidation), "Support Validation · impulso F78.6", color=color.rgb(255, 140, 0), linewidth=1, style=plot.style_linebr)
plot(f_plot(supportImpulseOrigin, supportLoaded and mostrarSupportValidation), "Support Validation · origen impulso", color=color.gray, style=plot.style_linebr)
plot(f_plot(supportImpulsePeak, supportLoaded and mostrarSupportValidation), "Support Validation · pico impulso", color=color.silver, style=plot.style_linebr)

// Contexto diario calculado por MarketBot.
plot(f_plot(pivotAvwap, swingLoaded and mostrarAvwap), "Swing Diario · AVWAP pivot", color=color.yellow, linewidth=2, style=plot.style_linebr)
plot(f_plot(breakoutAvwap, swingLoaded and mostrarAvwap), "Swing Diario · AVWAP breakout", color=color.rgb(255, 145, 0), linewidth=2, style=plot.style_linebr)
plot(f_plot(swingSma20, swingLoaded and mostrarMedias), "Swing Diario · SMA20", color=color.orange, style=plot.style_linebr)
plot(f_plot(swingSma50, swingLoaded and mostrarMedias), "Swing Diario · SMA50", color=color.blue, style=plot.style_linebr)

string csvStatus = "OK v" + schemaVersion + " · " + str.tostring(array.size(csvHeader)) + " COLUMNAS"
if not rowFound
    csvStatus := "ERROR: BUSCA " + f_normalize_ticker(targetTicker)
else if not rowComplete
    csvStatus := "ERROR: FILA " + str.tostring(array.size(cfg)) + "/" + str.tostring(array.size(csvHeader))
else if not schemaValid
    csvStatus := "ERROR: ESQUEMA INTERNO"
var table panel = table.new(position.bottom_right, 2, 22, bgcolor=color.new(color.black, 10), border_width=1, border_color=color.rgb(65, 65, 65))
if barstate.islast and mostrarDashboard
    color labelBg = color.rgb(35, 40, 50)
    color valueBg = color.rgb(23, 23, 23)
    table.clear(panel, 0, 0, 1, 21)
    if not dataReady
        table.cell(panel, 0, 0, "MARKETBOT v3.3", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 0, syminfo.ticker + " ← SIN DATOS", text_color=color.white, bgcolor=valueBg)
        table.cell(panel, 0, 1, "CSV / ESQUEMA", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 1, csvStatus, text_color=color.red, bgcolor=valueBg)
        table.cell(panel, 0, 2, "TICKER BUSCADO", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 2, f_normalize_ticker(targetTicker), text_color=color.yellow, bgcolor=valueBg)
        table.cell(panel, 0, 3, "FORMATOS", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 3, "CSV / TAB / ;", text_color=color.white, bgcolor=valueBg)
    else
        table.cell(panel, 0, 0, "MARKETBOT v3.3", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 0, syminfo.ticker + " ← " + rowTicker + " · AUTO", text_color=color.white, bgcolor=valueBg)
        table.cell(panel, 0, 1, "CSV / ESQUEMA", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 1, csvStatus, text_color=color.lime, bgcolor=valueBg)
        table.cell(panel, 0, 2, "FUENTE / AS OF", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 2, dataSource + " / " + asOf, text_color=color.white, bgcolor=valueBg)
        table.cell(panel, 0, 3, "SWING DIARIO", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 3, swingVerdict + " " + swingDirection + " · SCORE " + swingScore + " · GATE " + swingGate, text_color=color.white, bgcolor=valueBg)
        table.cell(panel, 0, 4, "SWING ZONA", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 4, f_range(swingZoneLow, swingZoneHigh) + " · SOP " + str.tostring(swingSupport, "0.0000") + " · INV " + str.tostring(swingInvalidation, "0.0000"), text_color=color.white, bgcolor=valueBg)
        table.cell(panel, 0, 5, "RESIST / LIQ", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 5, str.tostring(swingResistance, "0.0000") + " / " + str.tostring(swingLiquidity, "0.0000"), text_color=color.white, bgcolor=valueBg)
        table.cell(panel, 0, 6, "AVWAP P / B", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 6, str.tostring(pivotAvwap, "0.0000") + " / " + str.tostring(breakoutAvwap, "0.0000"), text_color=color.white, bgcolor=valueBg)
        table.cell(panel, 0, 7, "SWINGTRADE", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 7, stGeometryStatus == "ENGINE_REJECTED" ? "ENGINE_REJECTED · SIN NIVELES" : stGeometryStatus + " · " + stMaturity + " · ELIGIBLE " + stEligible, text_color=stGeometryStatus == "ENGINE_REJECTED" ? color.red : color.white, bgcolor=valueBg)
        table.cell(panel, 0, 8, "ST IMPULSO", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 8, f_range(stImpulseLow, stImpulseHigh), text_color=color.white, bgcolor=valueBg)
        table.cell(panel, 0, 9, "ST F61.8-F50", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 9, f_range(stZoneLow, stZoneHigh), text_color=color.white, bgcolor=valueBg)
        table.cell(panel, 0, 10, "ST SOP / INV", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 10, str.tostring(stSupport20, "0.0000") + " / " + str.tostring(stInvalidation, "0.0000"), text_color=color.white, bgcolor=valueBg)
        table.cell(panel, 0, 11, "ST TARGETS", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 11, str.tostring(stPrimaryTarget, "0.0000") + " / " + str.tostring(stExtendedTarget, "0.0000"), text_color=color.white, bgcolor=valueBg)
        table.cell(panel, 0, 12, "GERI 4H", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 12, geriMaturity + " " + geriTradeSide + " · N" + geriLevelSequence + " " + geriLevelKind + " " + str.tostring(geriLevelPrice, "0.0000"), text_color=color.white, bgcolor=valueBg)
        table.cell(panel, 0, 13, "GERI ZONA / INV", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 13, f_range(geriZoneLow, geriZoneHigh) + " / " + str.tostring(geriInvalidation, "0.0000"), text_color=color.white, bgcolor=valueBg)
        table.cell(panel, 0, 14, "GERI N1 / N2 / N3", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 14, geriN1Kind + " " + str.tostring(geriN1Price, "0.0000") + " / " + geriN2Kind + " " + str.tostring(geriN2Price, "0.0000") + " / " + geriN3Kind + " " + str.tostring(geriN3Price, "0.0000"), text_color=color.white, bgcolor=valueBg)
        table.cell(panel, 0, 15, "GERI CONF", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 15, "BOUNCE " + geriBounce + " · FAST " + geriFast + " · 4H " + geriFourHour, text_color=color.white, bgcolor=valueBg)
        table.cell(panel, 0, 16, "SWING INVALIDADO", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 16, supportLoaded ? swingInvalidationSources : "NO", text_color=supportLoaded ? color.orange : color.white, bgcolor=valueBg)
        table.cell(panel, 0, 17, "SUPPORT VALIDATION", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 17, supportLoaded ? supportState + " · " + supportConfirmationType : "NO ACTIVADO", text_color=supportLoaded ? color.yellow : color.white, bgcolor=valueBg)
        table.cell(panel, 0, 18, "SUPPORT ZONA / INV", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 18, supportLoaded ? f_range(supportZoneLow, supportZoneHigh) + " / " + str.tostring(supportInvalidation, "0.0000") : "SIN_DATO", text_color=color.white, bgcolor=valueBg)
        table.cell(panel, 0, 19, "SUPPORT F50/F61.8/F78.6", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 19, supportLoaded ? str.tostring(supportFib50, "0.0000") + " / " + str.tostring(supportFib618, "0.0000") + " / " + str.tostring(supportFib786, "0.0000") : "SIN_DATO", text_color=color.white, bgcolor=valueBg)
        table.cell(panel, 0, 20, "SUPPORT IMPULSO", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 20, supportLoaded ? f_range(supportImpulseOrigin, supportImpulsePeak) + " · +" + supportImpulseAdvance + "%" : "SIN_DATO", text_color=color.white, bgcolor=valueBg)
        table.cell(panel, 0, 21, "SUPPORT SCORES", text_color=color.white, bgcolor=labelBg)
        table.cell(panel, 1, 21, supportLoaded ? "S " + supportScore + " · R " + supportReactionScore + " · REV " + supportReversalScore + " · ACT " + supportActionabilityScore + " · " + supportZonePosition : "SIN_DATO", text_color=color.white, bgcolor=valueBg)

if barstate.islast and not mostrarDashboard
    table.clear(panel, 0, 0, 1, 21)
