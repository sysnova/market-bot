# Copy to .env for local use. Never commit real credentials.
MARKETBOT_ENVIRONMENT=development
MARKETBOT_LOG_LEVEL=INFO
MARKETBOT_LOG_JSON=true
MARKETBOT_DATABASE_URL=postgresql://marketbot:marketbot@localhost:5432/marketbot
MARKETBOT_ENTRY_WATCHER_ENABLED=true
MARKETBOT_ENTRY_WATCH_TTL_DAYS=56
MARKETBOT_NATS_URL=nats://127.0.0.1:4222

# Alpaca Market Data (analysis-only; no order execution).
# MARKETBOT_ALPACA_API_KEY_ID=
# MARKETBOT_ALPACA_API_SECRET_KEY=
# Exact entry-confirmation artifact. Set 2.0.0 for immediate rollback.
MARKETBOT_ENTRY_CONFIRMATION_RULE_VERSION=3.0.0
MARKETBOT_ALPACA_DATA_FEED=iex
MARKETBOT_ALPACA_ADJUSTMENT=split
MARKETBOT_ALPACA_REST_BATCH_SIZE=20
MARKETBOT_ALPACA_DATA_BASE_URL=https://data.alpaca.markets
MARKETBOT_ALPACA_MARKET_DATA_STREAM_URL=wss://stream.data.alpaca.markets/v2

# Shared universe: active watchlist + positive holdings are read directly from the
# local PostgreSQL `stock` schema and refreshes as those tables change.
MARKETBOT_UNIVERSE_REFRESH_SECONDS=120
MARKETBOT_ALPACA_EXECUTION_ENABLED=false

# SEC EDGAR read-only analysis. Use a real monitored contact email before enabling.
MARKETBOT_SEC_ENABLED=false
# MARKETBOT_SEC_USER_AGENT=MarketBot/0.1 your-email@example.com
# The independent daily SEC bot scans only this inclusive recent date window.
MARKETBOT_SEC_FILING_LOOKBACK_DAYS=2
